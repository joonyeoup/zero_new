## Configuration Reference

### Key Config Sections

```toml
# Provider configuration
[providers]
fallback = "custom:http://localhost:8000/v1"

[providers.models."custom:http://localhost:8000/v1"]
model = "qwen-vl"
base_url = "http://localhost:8000/v1"
api_key = "not-needed"
temperature = 0.7
timeout_secs = 120

# Agent configuration
[agent]
compact_context = true
max_tool_iterations = 10
max_history_messages = 50
max_context_tokens = 32000

# Memory configuration
[memory]
backend = "sqlite"
auto_save = true
hygiene_enabled = true
archive_after_days = 7
purge_after_days = 30

# Security configuration
[security]
autonomy = "full"
workspace_only = true
allowed_commands = ["git", "npm", "cargo", "ls", "cat", "grep"]
forbidden_paths = ["/etc", "/root", "/home", "/usr"]

# Skills configuration
[skills]
open_skills_enabled = true
allow_scripts = false
prompt_injection_mode = "full"

# Channel configuration
[channels]
cli = true
message_timeout_secs = 300
ack_reactions = true

# Gateway configuration
[gateway]
port = 42617
host = "127.0.0.1"
require_pairing = true
```

### Environment Variable Overrides

```bash
export OLLAMA_HOST="http://localhost:8000"
export ZC_VLM_MODEL="qwen-vl"
export ZEROCLAW_CONFIG="/path/to/config.toml"
export ZEROCLAW_WORKSPACE="/path/to/workspace"
```

