// ── direct path ─────────────────────────────────────────────

pub struct Direct {
    pub url: String,
}

impl AnalyzeBackend for Direct {
    fn fetch(&self) -> Result<String, String> {
        let endpoint = format!("{}/analyze", self.url.trim_end_matches('/'));

        // One retry: tools server may still be binding at startup.
        let resp = match ureq::post(&endpoint).call() {
            Ok(r) => r,
            Err(e) => {
                eprintln!("[sidecar] tools call failed ({e}), retrying in 2s");
                std::thread::sleep(std::time::Duration::from_secs(2));
                ureq::post(&endpoint)
                    .call()
                    .map_err(|e| format!("POST {endpoint}: {e}"))?
            }
        };

        let json: serde_json::Value = resp
            .into_json()
            .map_err(|e| format!("decoding tools response: {e}"))?;

        eprintln!(
            "[sidecar] capture={}ms vlm={}ms",
            json["capture_ms"], json["vlm_ms"]
        );

        let result = json["result"].as_str().unwrap_or("").trim().to_string();
        if result.is_empty() {
            return Err("tools returned empty result field".into());
        }
        Ok(result)
    }

    fn name(&self) -> &'static str {
        "direct"
    }
}

// ── test double ─────────────────────────────────────────────

pub struct Mock {
    pub canned: String,
}

impl AnalyzeBackend for Mock {
    fn fetch(&self) -> Result<String, String> {
        Ok(self.canned.clone())
    }
    fn name(&self) -> &'static str {
        "mock"
    }
}

// ── selection ───────────────────────────────────────────────

pub fn from_env() -> Box<dyn AnalyzeBackend> {
    match std::env::var("TOOLS_HTTP_URL") {
        Ok(url) if !url.is_empty() => {
            eprintln!("[sidecar] backend=direct url={url}");
            Box::new(Direct { url })
        }
        _ => {
            let url = std::env::var("GATEWAY_URL")
                .unwrap_or_else(|_| "http://127.0.0.1:42617/webhook".into());
            eprintln!("[sidecar] backend=agentic url={url}");
            Box::new(Webhook { url })
        }
    }
}
