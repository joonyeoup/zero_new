async fn handle_analyze() -> Result<Json<serde_json::Value>, AppError> {
    let t0 = Instant::now();

    let shot_json = crate::run_screenshot()
        .map_err(|e| anyhow::anyhow!("run_screenshot: {e}"))?;
    let capture_ms = t0.elapsed().as_millis() as u64;

    // run_screenshot returns {"image_path": "..."}, not a bare path.
    let parsed: serde_json::Value = serde_json::from_str(&shot_json)
        .map_err(|e| anyhow::anyhow!("screenshot result not JSON: {e}"))?;
    let img = parsed["image_path"]
        .as_str()
        .ok_or_else(|| anyhow::anyhow!("screenshot result missing image_path: {shot_json}"))?;

    let result = crate::vlm::run_analyze_image_structured(
        std::path::Path::new(img)
    ).await?;
    let vlm_ms = t0.elapsed().as_millis() as u64 - capture_ms;

    eprintln!("[tools] capture={capture_ms}ms vlm={vlm_ms}ms");

    Ok(Json(serde_json::json!({
        "result": result,
        "capture_ms": capture_ms,
        "vlm_ms": vlm_ms,
    })))
}
