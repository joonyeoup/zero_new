
//! Pluggable source for the six-field JSON candidate.
//!
//! `Webhook` = the agentic path (gateway -> agent loop -> MCP -> VLM).
//! `Direct`  = MCP-free path (tv-screen-tools --serve -> tzcapturesample + VLM).
//! Selected at startup by TOOLS_HTTP_URL.

use crate::stagelog::StageLog;
use crate::Cfg;
use serde_json::Value;

pub trait AnalyzeBackend: Send + Sync {
    /// Short tag: used in stage names, logs, and the X-Backend header.
    fn name(&self) -> &'static str;

    /// Error code when the backend itself fails (transport, HTTP, empty).
    fn failure_code(&self) -> &'static str;

    /// Error code when the backend returns text that won't validate.
    fn invalid_code(&self) -> &'static str;

    /// Produce the raw candidate text for validation.
    fn fetch(
        &self,
        cfg: &Cfg,
        message: &str,
        session_id: &str,
        log: &StageLog,
    ) -> Result<String, String>;

    /// Second attempt after a validation failure.
    /// `None` means this backend has no meaningful retry.
    fn retry(
        &self,
        _cfg: &Cfg,
        _session_id: &str,
        _log: &StageLog,
    ) -> Option<Result<String, String>> {
        None
    }
}

// ── agentic path ────────────────────────────────────────────

pub struct Webhook;

impl AnalyzeBackend for Webhook {
    fn name(&self) -> &'static str {
        "agentic"
    }
    fn failure_code(&self) -> &'static str {
        "GATEWAY_FAILED"
    }
    fn invalid_code(&self) -> &'static str {
        "AGENT_OUTPUT_INVALID"
    }

    fn fetch(
        &self,
        cfg: &Cfg,
        message: &str,
        session_id: &str,
        log: &StageLog,
    ) -> Result<String, String> {
        let text = crate::webhook(cfg, message, session_id, log)?;

        // Preserve the existing preference for the tool result from the
        // trace file over the agent's own prose.
        Ok(match crate::last_tool_result(cfg) {
            Some(t) => {
                log.note("using tool result");
                t
            }
            None => {
                log.note("tool result unavailable, using agent text");
                text
            }
        })
    }

    fn retry(
        &self,
        cfg: &Cfg,
        session_id: &str,
        log: &StageLog,
    ) -> Option<Result<String, String>> {
        // Same conversation, ask for corrected JSON.
        Some(crate::webhook(cfg, crate::RETRY_NUDGE, session_id, log))
    }
}

// ── direct path ─────────────────────────────────────────────

pub struct Direct {
    pub url: String,
}

impl AnalyzeBackend for Direct {
    fn name(&self) -> &'static str {
        "direct"
    }
    fn failure_code(&self) -> &'static str {
        "TOOLS_FAILED"
    }
    fn invalid_code(&self) -> &'static str {
        "VLM_OUTPUT_INVALID"
    }

    fn fetch(
        &self,
        cfg: &Cfg,
        _message: &str,
        _session_id: &str,
        log: &StageLog,
    ) -> Result<String, String> {
        let endpoint = format!("{}/analyze", self.url.trim_end_matches('/'));
        log.note(&format!("POST {endpoint}"));

        let agent = ureq::AgentBuilder::new()
            .timeout(std::time::Duration::from_secs(cfg.total_timeout_secs))
            .build();

        // One retry on transport failure: tools server may still be binding.
        let resp = match agent.post(&endpoint).call() {
            Ok(r) => r,
            Err(first) => {
                log.note(&format!("tools call failed ({first}), retrying in 2s"));
                std::thread::sleep(std::time::Duration::from_secs(2));
                agent
                    .post(&endpoint)
                    .call()
                    .map_err(|e| format!("tools request failed: {e}"))?
            }
        };

        let body: Value = resp
            .into_json()
            .map_err(|e| format!("tools response was not JSON: {e}"))?;

        log.note(&format!(
            "capture_ms={} vlm_ms={}",
            body["capture_ms"], body["vlm_ms"]
        ));

        body["result"]
            .as_str()
            .map(str::to_string)
            .filter(|s| !s.trim().is_empty())
            .ok_or_else(|| format!("tools response missing 'result' field: {body}"))
    }

    // No retry: a second attempt re-runs capture + VLM (~7s) for a case
    // lenient_validate already tries to recover from. Fail loud instead.
    // To enable: Some(self.fetch(cfg, "", session_id, log))
}

// ── test double ─────────────────────────────────────────────

#[allow(dead_code)]
pub struct Mock {
    pub canned: String,
}

impl AnalyzeBackend for Mock {
    fn name(&self) -> &'static str {
        "mock"
    }
    fn failure_code(&self) -> &'static str {
        "MOCK_FAILED"
    }
    fn invalid_code(&self) -> &'static str {
        "MOCK_OUTPUT_INVALID"
    }
    fn fetch(&self, _: &Cfg, _: &str, _: &str, _: &StageLog) -> Result<String, String> {
        Ok(self.canned.clone())
    }
}

// ── selection ───────────────────────────────────────────────

pub fn from_env() -> Box<dyn AnalyzeBackend> {
    match std::env::var("TOOLS_HTTP_URL") {
        Ok(url) if !url.trim().is_empty() => {
            eprintln!("backend=direct url={url}");
            Box::new(Direct { url })
        }
        _ => {
            eprintln!("backend=agentic");
            Box::new(Webhook)
        }
    }
}

