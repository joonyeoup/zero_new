fn run_analyze_screen(args: &Value) -> Result<String, String> {
    let started = std::time::Instant::now();
    run_screenshot()?;
    log(&format!("merged: capture done ({}ms)", started.elapsed().as_millis()));
    let out = run_analyze_image(args)?;
    log(&format!("=== TOTAL: analyze_screen completed in {}ms ===",
                 started.elapsed().as_millis()));
    Ok(out)
}

            "screenshot" => run_screenshot(),
            "analyze_image" => run_analyze_image(&params["arguments"]),
            "analyze_screen" => run_analyze_screen(&params["arguments"]),
